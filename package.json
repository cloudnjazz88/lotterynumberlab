{
  "name": "us-lottery-stats-site",
  "version": "3.0.0",
  "private": true,
  "description": "Static statistics site for Mega Millions and Powerball: computed odds, long-form guides, and number generators weighted by the real drawing history",
  "scripts": {
    "build": "node tools/build-site.mjs",
    "start": "node tools/serve.mjs",
    "update-data": "node tools/fetch-draws.mjs && node tools/build-site.mjs",
    "validate": "node tools/validate.mjs",
    "smoke": "node tools/browser-check.mjs",
    "check": "node tools/validate.mjs && node tools/browser-check.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^24.10.0"
  }
}
