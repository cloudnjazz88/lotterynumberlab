# Copied into dist/ by the site build. HTML is short-lived so a draw refresh
# is visible quickly; fingerprinted-looking static files can live longer.
/*
  Cache-Control: public, max-age=300

/styles.css
  Cache-Control: public, max-age=86400

/src/*
  Cache-Control: public, max-age=86400

/data/draws.js
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=86400
