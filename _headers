# Copied into dist/ by the site build.
# Matching rules combine, so never set Cache-Control on both a catch-all and a
# more specific path. That previously produced
# "public, max-age=300, public, max-age=86400" on /styles.css.

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/src/*
  Cache-Control: public, max-age=3600

/data/draws.js
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
